# ===== إعدادات الخادم =====
PORT=5000
NODE_ENV=development

# مجلد الصور المرفوعة.
# محليًا: اتركه فارغًا لاستخدام backend/uploads
# على Railway: Dockerfile يضبطه تلقائيًا إلى /data/uploads (اربط Volume على /data)
UPLOADS_DIR=

# ===== قاعدة البيانات =====
# محليًا: اتركه فارغًا → يستخدم SQLite تلقائيًا (backend/db/realEstate.db)
# على Railway: أضف خدمة PostgreSQL وسيُضبط DATABASE_URL تلقائيًا في المتغيرات
DATABASE_URL=

# ===== الأمان =====
# مفتاح توقيع JWT — في الإنتاج استخدم سلسلة عشوائية طويلة
JWT_SECRET=change-me-to-a-long-random-string

# كلمة مرور المدير — تُستخدم فقط عند إنشاء حساب المدير أول مرة (قاعدة بيانات فارغة)
# اسم المستخدم الافتراضي: benishaty
ADMIN_PASSWORD=Bn@2026!Secure#

# ===== بيانات أولية اختيارية (تُستخدم عند أول تشغيل فقط) =====
CONTACT_PHONE=
COMPANY_NAME=بي نيشتي للاستثمار العقاري
